# Static Astro site, served by the project's small Go HTTP server.
FROM node:24-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20 AS site-build
WORKDIR /src/site
COPY client/package.json /src/client/package.json
COPY packaging/windows/VERSION /src/packaging/windows/VERSION
COPY site/package.json site/package-lock.json ./
RUN npm ci
COPY site/ ./
RUN npm run build

FROM golang:1.27-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/quarel-site ./cmd/quarel-site
COPY cmd/quarel-probe ./cmd/quarel-probe
RUN CGO_ENABLED=0 go build -trimpath -o /out/quarel-site ./cmd/quarel-site \
 && CGO_ENABLED=0 go build -trimpath -o /out/quarel-probe ./cmd/quarel-probe

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/quarel-site /quarel-site
COPY --from=build /out/quarel-probe /quarel-probe
COPY --from=site-build --chown=65532:65532 /src/site/dist /site
COPY LICENSE NOTICE THIRD_PARTY_NOTICES.md /licenses/quarel/
EXPOSE 8080
ENTRYPOINT ["/quarel-site", "-addr", ":8080", "-root", "/site"]
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD ["/quarel-probe", "http://127.0.0.1:8080/health"]
